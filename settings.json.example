{
  "logs": {
    "member": "CHANNEL_ID",
    "server": "CHANNEL_ID",
    "textual": "CHANNEL_ID",
    "voice": "CHANNEL_ID",
    "moderation": "CHANNEL_ID",
    "bot": "CHANNEL_ID"
  },
  "llm": {
    "providerBaseUrl": "https://api.groq.com/openai/v1",
    "primaryModel": "qwen/qwen3.8-27b",
    "fallbackModel": "qwen/qwen3.6-27b"
  },
  "aiChat": {
    "channels": ["CHANNEL_ID_1", "CHANNEL_ID_2"],
    "decision": {
      "url": "https://decision.vllm-sr.ai/v1/systemone",
      "apiKey": "YOUR_VLLM_SR_API_KEY_HERE",
      "model": "vllm-sr/d3-ultra",
      "replyThreshold": 0.6,
      "timeoutSeconds": 8
    },
    "contextMessages": 20,
    "maxContextChars": 6000,
    "debounceSeconds": 4,
    "cooldownSeconds": 60,
    "maxRepliesPerHour": 12,
    "followUpSeconds": 120
  },
  "contentModeration": {
    "enabled": true,
    "model": "vllm-sr/d3-flash",
    "timeoutSeconds": 5,
    "minLength": 12,
    "thresholds": { "scam": 0.7, "personalInfo": 0.6, "inappropriate": 0.6 },
    "ignoredChannels": []
  },
  "tickets": {
    "categoryID": "YOUR_CATEGORY_ID_HERE",
    "transcriptChannelID": "YOUR_TRANSCRIPT_CHANNEL_ID_HERE",
    "teams": [
      {
        "name": "Support",
        "emojiID": "👨‍💼",
        "roleIDs": [
          "ROLE_ID_1"
        ]
      },
      {
        "name": "Modération",
        "emojiID": "⚔️",
        "roleIDs": [
          "ROLE_ID_2",
          "ROLE_ID_3",
          "ROLE_ID_4"
        ]
      }
    ]
  },
  "toClose": {
    "schedule": {
      "default": ["23h56", "23h00"],
      "monday": [],
      "tuesday": [],
      "wednesday": [],
      "thursday": [],
      "friday": [],
      "saturday": [],
      "sunday": []
    },
    "roles": {
      "roleID": ["channelToCloseID", "channelToClose2ID..."]
    }
  },
  "modVoice": {
    "moderatorRoleIDs": ["MODERATOR_ROLE_ID"],
    "channelIDs": ["VOICE_CHANNEL_ID"],
    "sweepMinutes": 5
  },
  "collect": {
    "ignoredChannelIDs": ["SALON_OU_CATEGORIE_A_EXCLURE_1", "SALON_OU_CATEGORIE_A_EXCLURE_2"]
  }
}
